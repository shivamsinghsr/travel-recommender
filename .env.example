# Copy to .env for local runs. Every setting is optional except in production.
ENVIRONMENT=development            # "production" enforces a real SECRET_KEY
DATABASE_URL=sqlite:///./travel.db # e.g. postgresql://user:pass@host:5432/travel
REDIS_URL=                         # e.g. redis://localhost:6379/0 (in-process cache when empty)
SECRET_KEY=                        # 32+ random characters: python -c "import secrets; print(secrets.token_urlsafe(48))"
DEMO_PASSWORD=travel-demo          # lets the 800 sample travellers sign in (leave empty to disable)
CORS_ORIGINS=*                     # comma-separated origins allowed to call the API from a browser
MODELS_DIR=./models                # where trained model versions are stored
MODEL_CHECK_SECONDS=900            # how often the API checks for a newly activated model
